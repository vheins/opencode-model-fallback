  },
  "devDependencies": {
    "@ai-sdk/provider": "^3.0.0",
    "@opencode-ai/plugin": "^1.17.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vheins/opencode-model-fallback.git"
